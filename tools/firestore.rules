rules_version = '2';
// 天下戰力榜（data/leaderboard.js）與 GM 管理頁（gm.html）的 Firestore 安全規則：
// 貼到 Firebase 主控台 → Firestore → 規則 → 發布（ARCHITECTURE.md 第 42、50 節）
//
// 防作弊：只能寫自己的那筆（匿名登入 uid）、欄位型別與範圍檢查、戰力不可超過「400 ＋ 境界 × 40」（2026-09-28 數值重做後的新制上限）、
// 上傳至少間隔 60 秒、被封鎖（banned/{uid}）的不能再上傳、每筆保留最近 24 次上傳的戰力歷史 hist（GM 比對暴增）。擋得住隨手改數字，擋不住會改存檔的高手（戰力是玩家端算的）。
//
// 死守天南城通關榜：玩家送審到 defenseSubmit/{uid}，GM 審核通過才寫入 defenseBoard/{uid}（玩家不能直接上榜）。
//
// 管理者：在主控台手動建立 admins/{管理者的 Google 登入 uid}（任意欄位）。只有管理者能刪除榜單、讀取完整榜單、管理黑名單、寄信與建立兌換碼。
//
// 仙府信箱（mail／mailClaims）與兌換碼（codes／codeClaims）：GM 寄出，玩家每封／每組代碼限領一次（2026-09-28）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/banned/$(uid));
    }

    // 管理者名單：只能在主控台新增；登入者只能確認「自己」是不是管理者
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 黑名單：文件 id = 被封鎖的玩家 uid。玩家只能查自己有沒有被封；管理者可讀寫
    match /banned/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // 死守天南城送審（data/leaderboard.js 的 flushDefenseSubmit）：玩家只能寫自己的一筆個人最佳；
    // 審核結果 status／reason／reviewedAt 只有管理者能寫（玩家的欄位白名單不含），玩家重新送審（set 整筆覆寫）時審核狀態自動清除
    match /defenseSubmit/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && !isBanned(uid) && validDefense();
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid && !isBanned(uid) && validDefense()
                        && request.time > resource.data.updatedAt + duration.value(60, 's'));

      function validDefense() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'best', 'atk', 'power', 'realm', 'stage', 'level', 'kills', 'runAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.best is int && d.best >= 1 && d.best <= 100
          && d.atk is number && d.atk >= 0 && d.power is number && d.power >= 0
          && d.realm is int && d.realm >= 0 && d.realm <= 15
          && d.stage is int && d.stage >= 1 && d.stage <= 10
          && d.level is int && d.level >= 1 && d.level <= 10000
          && d.kills is int && d.kills >= 0
          && d.runAt is int
          // 與戰力榜相同的戰力上限（新制，2026-09-28）；新制戰力 = 攻擊 × 暴擊連擊技能期望（1.8～2.3 倍），攻擊一定小於戰力
          && d.power <= 400 + d.realm * 40
          && d.atk <= d.power
          && d.updatedAt == request.time;
      }
    }

    // 死守天南城通關榜：所有人可讀（單次最多 100 筆），只有管理者（gm.html 審核通過）能寫
    match /defenseBoard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 100 || isAdmin();
      allow write: if isAdmin();
    }

    // ---- 仙府信箱與兌換碼（data/mailbox.js、gm.html「📮 發放獎勵」，ARCHITECTURE.md 第 56 節）----
    // 信件：GM 寫；玩家只能讀寄給全服（to == 'all'）或寄給自己 uid 的信（遊戲以 where('to', 'in', ['all', uid]) 查詢）
    match /mail/{mailId} {
      // 2026-10-04：isAdmin() 本身要多讀 1 次（exists），放最後；玩家的查詢先符合前面的條件就不會再讀
      allow get, list: if (request.auth != null && resource.data.to in ['all', request.auth.uid]) || isAdmin();
      allow create, update: if isAdmin();
      // 隔日自動刪除（2026-10-04）：寄給自己或全服、已過期（expiresAt 已過或寄出超過 24 小時）的信，玩家的遊戲讀到就可以刪（config-mailbox.js 的 MAIL_LIFETIME_HOURS）
      allow delete: if (request.auth != null && resource.data.to in ['all', request.auth.uid]
          && ((resource.data.get('expiresAt', null) != null && resource.data.expiresAt < request.time)
              || resource.data.createdAt < request.time - duration.value(24, 'h')))
        || isAdmin();
    }
    // 領取紀錄：文件 id 必須是「自己的 uid_信件 id」，只能建立一次（已存在時 set 會變成 update 而被拒絕），玩家不能改、不能刪
    // 信件必須存在、寄給全服或自己、沒過期；被封鎖的帳號不能領
    match /mailClaims/{claimId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, delete: if isAdmin();
      allow update: if false;
      allow create: if request.auth != null && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'mailId', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mailId is string
        && claimId == request.auth.uid + '_' + request.resource.data.mailId
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/mail/$(request.resource.data.mailId))
        && get(/databases/$(database)/documents/mail/$(request.resource.data.mailId)).data.to in ['all', request.auth.uid]
        && (get(/databases/$(database)/documents/mail/$(request.resource.data.mailId)).data.get('expiresAt', null) == null
            || get(/databases/$(database)/documents/mail/$(request.resource.data.mailId)).data.expiresAt > request.time);
    }
    // 兌換碼：文件 id = 代碼（大寫）。玩家知道代碼才能讀（get），不能列出全部；只有 GM 能建立、修改、刪除
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list, write: if isAdmin();
    }
    // 兌換紀錄：文件 id =「自己的 uid_代碼」，每組代碼每個帳號只能建立一次；代碼必須存在且沒過期
    match /codeClaims/{claimId} {
      allow get: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, delete: if isAdmin();
      allow update: if false;
      allow create: if request.auth != null && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'code', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code is string
        && claimId == request.auth.uid + '_' + request.resource.data.code
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && (get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.get('expiresAt', null) == null
            || get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.expiresAt > request.time);
    }

    // ---- 修仙留言板（data/msgboard.js、gm.html「💬 留言板」，ARCHITECTURE.md 第 57 節）----
    // 留言：所有人可讀（單次最多 50 筆）；建立時必須同一批次把 boardLimit/{自己} 更新成現在（見下），所以每人每 60 秒最多一則
    // 本人可刪自己的留言；GM 可刪任何留言；被封鎖（banned）或禁言（muted）的帳號不能留言；不能修改
    match /board/{msgId} {
      allow get: if true;
      allow list: if request.query.limit <= 50 || isAdmin();
      allow update: if false;
      // 自己的留言隨時可刪；超過 8 小時的留言任何登入者都能刪（自動清除，config-leaderboard.js 的 MSGBOARD_LIFETIME_HOURS）
      allow delete: if (request.auth != null && (resource.data.uid == request.auth.uid || resource.data.createdAt < request.time - duration.value(28800, 's'))) || isAdmin();
      allow create: if request.auth != null && !isBanned(request.auth.uid)
        && !exists(/databases/$(database)/documents/muted/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'name', 'realm', 'stage', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.realm is int && request.resource.data.realm >= 0 && request.resource.data.realm <= 15
        && request.resource.data.stage is int && request.resource.data.stage >= 1 && request.resource.data.stage <= 10
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 100
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/boardLimit/$(request.auth.uid)).data.lastAt == request.time;
    }
    // 留言板彙整（2026-10-09，節省讀取額度）：boardFeed/latest = { msgs: [最新 30 則，新的在前] }，玩家打開留言板只讀這 1 份文件
    // 每則 = { id, uid, name, realm, stage, text, createdAt }；GM 可任意改寫（刪除留言後重建）；isAdmin() 放最後（它要多讀 1 次 admins）
    // 玩家新增：同一交易建立 board/{id}（上面的規則把關內容、禁言、60 秒冷卻），msgs[0] 必須和那則留言一致，其餘照抄舊的前 29 則
    // 玩家刪除：只能拿掉自己的一則，其餘不變
    function feedEntryOk(e) {
      let m = getAfter(/databases/$(database)/documents/board/$(e.id)).data;
      return e.keys().hasOnly(['id', 'uid', 'name', 'realm', 'stage', 'text', 'createdAt'])
        && e.uid == request.auth.uid && m.uid == e.uid && m.name == e.name && m.realm == e.realm
        && m.stage == e.stage && m.text == e.text && m.createdAt == request.time
        && e.createdAt is timestamp
        && e.createdAt > request.time - duration.value(600, 's') && e.createdAt < request.time + duration.value(600, 's');
    }
    match /boardFeed/{fid} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if (fid == 'latest' && request.auth != null
        && request.resource.data.keys().hasOnly(['msgs']) && request.resource.data.msgs is list
        && request.resource.data.msgs.size() == 1 && feedEntryOk(request.resource.data.msgs[0])) || isAdmin();
      allow update: if (fid == 'latest' && request.auth != null
        && request.resource.data.keys().hasOnly(['msgs']) && request.resource.data.msgs is list
        && ((request.resource.data.msgs.size() == (resource.data.msgs.size() < 30 ? resource.data.msgs.size() + 1 : 30)
             && request.resource.data.msgs[1:] == resource.data.msgs[0:request.resource.data.msgs.size() - 1]
             && feedEntryOk(request.resource.data.msgs[0]))
          || (request.resource.data.msgs.size() == resource.data.msgs.size() - 1
             && request.resource.data.msgs.removeAll(resource.data.msgs).size() == 0
             && resource.data.msgs.removeAll(request.resource.data.msgs).size() == 1
             && resource.data.msgs.removeAll(request.resource.data.msgs)[0].uid == request.auth.uid))) || isAdmin();
    }
    // 每人最後留言時間：只能寫自己的；更新時距上次必須超過 60 秒
    match /boardLimit/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, delete: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastAt']) && request.resource.data.lastAt == request.time
        && request.time > resource.data.lastAt + duration.value(60, 's');
    }
    // 禁言名單：玩家只能查自己有沒有被禁言；GM 管理
    match /muted/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow list, write: if isAdmin();
    }

    // ---- 寄售拍賣（data/market.js，ARCHITECTURE.md 第 58 節）----
    // 拍賣品：所有人可讀（清單單次 ≤ 50；查自己賣的／自己出價的不限）
    match /market/{lid} {
      allow get: if true;
      allow list: if request.query.limit <= 50
        || (request.auth != null && (resource.data.seller == request.auth.uid || resource.data.bidder == request.auth.uid)) || isAdmin();
      // 上架：賣家是自己、沒有出價、結束時間在 12～48 小時之間（多留 1 分鐘誤差）
      allow create: if request.auth != null && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'kind', 'item', 'label', 'startPrice', 'bid', 'bidder', 'bidderName', 'bidCount', 'createdAt', 'endsAt'])
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.sellerName is string && request.resource.data.sellerName.size() >= 1 && request.resource.data.sellerName.size() <= 12
        && request.resource.data.kind in ['blueprint', 'equip', 'material', 'item']
        && request.resource.data.item is map
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && request.resource.data.startPrice is int && request.resource.data.startPrice >= 1 && request.resource.data.startPrice <= 1000000000000
        && request.resource.data.bid == 0 && request.resource.data.bidder == null && request.resource.data.bidderName == '' && request.resource.data.bidCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.endsAt >= request.time + duration.value(12 * 3600 - 60, 's')
        && request.resource.data.endsAt <= request.time + duration.value(48 * 3600 + 60, 's');
      // 出價：不是賣家、不是目前最高出價者、還沒結束；只能改出價相關欄位；至少多 5%；
      // 最後 5 分鐘可把結束時間延到「現在 + 5 分鐘」（多留 1 分鐘誤差）；有前一位出價者時，同一交易必須寫好他的退款單
      allow update: if request.auth != null && !isBanned(request.auth.uid)
        && request.auth.uid != resource.data.seller && request.auth.uid != resource.data.bidder
        && request.time < resource.data.endsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bid', 'bidder', 'bidderName', 'bidCount', 'endsAt'])
        && request.resource.data.bidder == request.auth.uid
        && request.resource.data.bidderName is string && request.resource.data.bidderName.size() >= 1 && request.resource.data.bidderName.size() <= 12
        && request.resource.data.bidCount == resource.data.bidCount + 1
        && request.resource.data.bid is int && request.resource.data.bid <= 1000000000000
        && request.resource.data.bid >= resource.data.startPrice
        && request.resource.data.bid >= resource.data.bid + 1 && request.resource.data.bid >= resource.data.bid * 1.05
        && (request.resource.data.endsAt == resource.data.endsAt
            || (request.resource.data.endsAt > resource.data.endsAt && request.resource.data.endsAt <= request.time + duration.value(360, 's')))
        && (resource.data.bidder == null
            || existsAfter(/databases/$(database)/documents/marketRefunds/$(lid + '_' + string(resource.data.bidCount))));
      // 刪除：沒人出價時賣家可下架（結標前後皆可）；成交且兩邊都領完時賣家或得標者可刪；GM 可刪
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.seller == request.auth.uid && resource.data.bidder == null)
        || (request.auth != null && (resource.data.seller == request.auth.uid || resource.data.bidder == request.auth.uid)
            && exists(/databases/$(database)/documents/marketClaims/$(lid + '_item'))
            && exists(/databases/$(database)/documents/marketClaims/$(lid + '_coins')));
    }
    // 退款單：只能在出價交易中、為「被超過的前一位出價者」建立（金額＝他的出價）；本人刪除＝領回
    match /marketRefunds/{rid} {
      allow get, list, delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'listingId', 'label', 'at'])
        && request.resource.data.at == request.time
        && request.resource.data.listingId is string
        && request.resource.data.label is string && request.resource.data.label.size() <= 80
        && rid == request.resource.data.listingId + '_' + string(get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidCount)
        && request.resource.data.uid == get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidder
        && request.resource.data.amount == get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bid
        && getAfter(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidder == request.auth.uid
        && getAfter(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidCount
           == get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidCount + 1;
    }
    // 結標領取：得標者建立 {id}_item、賣家建立 {id}_coins；拍賣品要已結束且有人出價；每種只能建立一次
    match /marketClaims/{cid} {
      allow get: if request.auth != null;
      allow list, delete: if isAdmin();
      allow update: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'listingId', 'type', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.type in ['item', 'coins']
        && cid == request.resource.data.listingId + '_' + request.resource.data.type
        && request.time > get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.endsAt
        && get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidder != null
        && ((request.resource.data.type == 'item' && get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.bidder == request.auth.uid)
            || (request.resource.data.type == 'coins' && get(/databases/$(database)/documents/market/$(request.resource.data.listingId)).data.seller == request.auth.uid));
    }

    match /leaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 100 || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && !isBanned(uid) && validEntry()
                    && request.resource.data.get('hist', []) == [] && request.resource.data.get('hist2', []) == [];
      allow update: if request.auth != null && request.auth.uid == uid && !isBanned(uid) && validEntry()
                    && request.time > resource.data.updatedAt + duration.value(60, 's')
                    && request.resource.data.hist == nextHist(resource.data)
                    && request.resource.data.hist2 == nextHist2(resource.data);
      allow delete: if isAdmin();

      // 上傳歷史（GM 後台比對戰力暴增用，第 50 節）：每次更新都必須把「上一筆的戰力 p 與時間 t」原封不動接到尾端，只留最近 24 筆
      // （24 = config-leaderboard.js 的 LEADERBOARD_HISTORY_SIZE）。玩家改不了舊的戰力與時間，暴增的證據會留到被後面 24 次上傳擠掉為止
      function nextHist(o) {
        let full = o.get('hist', []).concat([{'p': o.power, 't': o.updatedAt}]);
        return full.size() > 24 ? full[full.size() - 24:full.size()] : full;
      }
      // 兩日紀錄（2026-09-27）：上一筆距 hist2 最後一筆 ≥ 30 分鐘才接上，只留最近 96 筆（約 2 天）；否則原封不動
      // （1800 秒／96 = config-leaderboard.js 的 LEADERBOARD_HISTORY2_GAP_SEC／LEADERBOARD_HISTORY2_SIZE）
      function nextHist2(o) {
        let h = o.get('hist2', []);
        let due = h.size() == 0 || o.updatedAt >= h[h.size() - 1].t + duration.value(1800, 's');
        let kept = h.size() >= 96 ? h[h.size() - 95:h.size()] : h;
        return due ? kept.concat([{'p': o.power, 't': o.updatedAt}]) : h;
      }

      function validEntry() {
        let d = request.resource.data;
        // av：玩家選用的頭像 id（2026-09-28，戰力榜每列右側顯示；選填，舊版程式不上傳也可以）
        return d.keys().hasOnly(['name', 'power', 'realm', 'stage', 'level', 'sect', 'av', 'hist', 'hist2', 'updatedAt'])
          && (!('av' in d) || (d.av is string && d.av.size() <= 32))
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.sect is string && d.sect.size() <= 20
          && d.realm is int && d.realm >= 0 && d.realm <= 15
          && d.stage is int && d.stage >= 1 && d.stage <= 10
          && d.level is int && d.level >= 1 && d.level <= 10000
          && d.power is number && d.power >= 0
          // 戰力上限（數值重做新制，2026-09-28，ARCHITECTURE.md 第 52 節）= 400 ＋ 境界 × 40（凡人 400、混沌道祖 1000）：
          //   新制戰力 = 每回合期望輸出（numeric.js 的 nv2CombatPower）。本機以「白金 +20 武器、職業滿階＋傳承＋劍體、丹藥藏書閣全滿、至尊靈根、增益 +200% 上限」
          //   量得理論最高 凡人 163、金丹 210、煉虛 286、渡劫 365、真仙 425、混沌道祖 463，上限留 2 倍以上空間
          //   舊制上限（10^境界 × 階 × 7 × 200 ＋ 等級 × 20 萬）已不適用；快取中的舊版程式上傳的億兆級戰力會被擋下
          && d.power <= 400 + d.realm * 40
          && d.updatedAt == request.time;
      }
    }

    // ==================== 世界 Boss（2026-10-04，ARCHITECTURE.md 第 75 節；data/config-world-boss.js、world-boss.js）====================
    // 數字與 config-world-boss.js 的 WB 一致（改一邊要一起改）：每天 3 次、間隔 60 秒、單次上限固定 10000000（2026-10-09 起；原為總血量 1%）、
    // 開放時段＝週六 12:00 UTC 起 24 小時（startAt 毫秒 % 604800000 == 216000000）、第一隻 4 億（10/9 前 4000 萬）、血量下限 400 萬／上限 4 兆、結束 24 小時後領獎。
    // ⭐有效挑戰（eff）＝玩家端回報撐滿 30 回合，規則只限制每次 +0 或 +1（沒有數值獎勵）。
    // wboss/state：目前的 Boss。玩家可以 ① 第一次建立 ② 上一隻結束後換成本週這隻（時段、血量推算由規則檢查）③ 挑戰時扣血（與自己的傷害紀錄同一筆交易）
    match /wboss/{docId} {
      allow get: if request.auth != null;
      allow list, delete: if isAdmin();
      allow create: if (request.auth != null && docId == 'state' && wbCreateOk()) || isAdmin();
      allow update: if (request.auth != null && docId == 'state' && (wbRolloverOk() || wbDamageOk())) || isAdmin();

      function wbKeysOk(d) {
        return d.keys().hasOnly(['bid', 'bossIdx', 'maxHp', 'hp', 'cap', 'startAt', 'endAt', 'killedAt', 'lastUid', 'lastName', 'prev'])
          && d.bossIdx is int && d.bossIdx >= 0 && d.bossIdx < 16
          && d.killedAt == null && d.lastUid == '' && d.lastName == '';
      }
      function wbWindowOk(d) {
        return d.startAt.toMillis() % 604800000 == 216000000
          && d.endAt == d.startAt + duration.value(86400, 's')
          && request.time >= d.startAt && request.time < d.endAt
          && d.bid == string(d.startAt.toMillis());
      }
      function wbHpOk(d) {
        return d.maxHp is int && d.hp == d.maxHp && d.cap == 10000000;
      }
      function wbCreateOk() {
        let d = request.resource.data;
        return wbKeysOk(d) && wbWindowOk(d) && wbHpOk(d) && d.maxHp == 400000000 && d.prev == null;
      }
      // 換隻：上一隻已結束；被打死 → 血量 ×2（上限 4 兆），沒打死 → ÷2 取整（下限 400 萬）
      function wbRolloverOk() {
        let o = resource.data;
        let d = request.resource.data;
        return d.bid != o.bid && request.time >= o.endAt
          && wbKeysOk(d) && wbWindowOk(d) && wbHpOk(d)
          && d.prev == {'bid': o.bid, 'maxHp': o.maxHp, 'killed': o.killedAt != null, 'endAt': o.endAt, 'lastUid': o.get('lastUid', '')}
          && ((o.killedAt != null && (d.maxHp == o.maxHp * 2 || (o.maxHp * 2 > 4000000000000 && d.maxHp == 4000000000000)))
              || (o.killedAt == null && (d.maxHp * 2 == o.maxHp || d.maxHp * 2 == o.maxHp - 1 || (o.maxHp / 2 < 4000000 && d.maxHp == 4000000))));
      }
      // 扣血：開放中、還沒死；同一筆交易裡自己的傷害紀錄（wbossRuns）也要寫入（扣多少由那邊的規則對帳）；打到 0 記最後一擊
      function wbDamageOk() {
        let o = resource.data;
        let d = request.resource.data;
        return request.time >= o.startAt && request.time < o.endAt && o.hp > 0
          && d.hp is int && d.hp >= 0 && d.hp < o.hp
          && getAfter(/databases/$(database)/documents/wbossRuns/$(o.bid)/dmg/$(request.auth.uid)).data.lastAt == request.time
          && ((d.hp > 0 && d.diff(o).affectedKeys().hasOnly(['hp']))
              || (d.hp == 0 && d.diff(o).affectedKeys().hasOnly(['hp', 'killedAt', 'lastUid', 'lastName'])
                  && d.killedAt == request.time && d.lastUid == request.auth.uid && d.lastName is string && d.lastName.size() <= 12));
      }
    }
    // 每人在某隻 Boss 的累計傷害（文件 id = uid）：次數、間隔、單次上限、Boss 扣血對帳都在這裡檢查；被封鎖的帳號不能寫
    match /wbossRuns/{bid}/dmg/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if request.query.limit <= 20 || isAdmin();
      allow delete: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && !isBanned(uid) && wbRunCreateOk(bid);
      allow update: if request.auth != null && request.auth.uid == uid && !isBanned(uid) && wbRunUpdateOk(bid);

      function wbSt() { return get(/databases/$(database)/documents/wboss/state).data; }
      function wbStAfter() { return getAfter(/databases/$(database)/documents/wboss/state).data; }
      function wbRunCommon(bid) {
        let st = wbSt();
        let d = request.resource.data;
        let t = request.time.toMillis() + 28800000;
        return d.keys().hasOnly(['uid', 'name', 'realm', 'stage', 'total', 'eff', 'n', 'day', 'dayN', 'lastAt', 'hist'])
          && d.uid == request.auth.uid && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.realm is int && d.realm >= 0 && d.realm <= 15 && d.stage is int
          && d.total is int && d.eff is int && d.n is int && d.dayN is int
          && d.day is int && d.day * 86400000 <= t && (d.day + 1) * 86400000 > t
          && d.lastAt == request.time && d.hist is list && d.hist.size() <= 6
          && st.bid == bid && request.time >= st.startAt && request.time < st.endAt && st.hp > 0;
      }
      // Boss 扣血對帳：交易後的血量 ＝ max(0, 交易前 − 這次傷害)；傷害 0 時 Boss 不更新（交易後 ＝ 交易前）
      function wbHpAfterOk(dd) {
        let st = wbSt();
        let after = wbStAfter();
        // 2026-10-10 世界 Boss 血量無限（config-world-boss.js 的 WB.infiniteHp）：允許不扣血（交易後血量 ＝ 交易前）
        return (st.hp - dd > 0 && after.hp == st.hp - dd) || (st.hp - dd <= 0 && after.hp == 0) || after.hp == st.hp;
      }
      function wbRunCreateOk(bid) {
        let d = request.resource.data;
        return wbRunCommon(bid) && d.n == 1 && d.dayN == 1
          && d.total >= 0   // 單次傷害不設上限（2026-10-10；原本 <= 10000000）
          && (d.eff == 0 || d.eff == 1)
          && wbHpAfterOk(d.total);
      }
      function wbRunUpdateOk(bid) {
        let o = resource.data;
        let d = request.resource.data;
        let dd = d.total - o.total;
        return wbRunCommon(bid) && d.n == o.n + 1 && request.time >= o.lastAt + duration.value(60, 's')
          && dd >= 0   // 單次傷害不設上限（2026-10-10；原本 <= 10000000）
          && (d.eff == o.eff || d.eff == o.eff + 1)
          && ((d.day == o.day && d.dayN == o.dayN + 1 && d.dayN <= 3) || (d.day != o.day && d.dayN == 1))
          && wbHpAfterOk(dd);
      }
    }
    // 領獎紀錄（id = bid_uid，只能建立一次）：Boss 結束滿 24 小時、有傷害紀錄、沒被封鎖
    match /wbossClaims/{cid} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list, delete: if isAdmin();
      allow update: if false;
      allow create: if request.auth != null && !isBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'bid', 'at'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.bid is string
        && cid == request.resource.data.bid + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/wbossRuns/$(request.resource.data.bid)/dmg/$(request.auth.uid))
        && wbClaimOpen(request.resource.data.bid);

      function wbClaimOpen(bid) {
        let st = get(/databases/$(database)/documents/wboss/state).data;
        return (st.bid == bid && request.time >= st.endAt + duration.value(86400, 's'))
          || (st.prev != null && st.prev.bid == bid && request.time >= st.prev.endAt + duration.value(86400, 's'));
      }
    }
  }
}
