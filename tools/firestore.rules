rules_version = '2';
// 天下戰力榜（data/leaderboard.js）的 Firestore 安全規則：貼到 Firebase 主控台 → Firestore → 規則 → 發布
// 基本防作弊：只能寫自己的那筆（匿名登入 uid）、欄位型別與範圍檢查、戰力不可超過境界上限、上傳至少間隔 60 秒。
// 擋得住隨手改數字，擋不住會改存檔的高手（戰力是玩家端算的）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create: if request.auth != null && request.auth.uid == uid && validEntry();
      allow update: if request.auth != null && request.auth.uid == uid && validEntry()
                    && request.time > resource.data.updatedAt + duration.value(60, 's');
      allow delete: if false;

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'power', 'realm', 'stage', 'level', 'sect', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
          && d.sect is string && d.sect.size() <= 20
          && d.realm is int && d.realm >= 0 && d.realm <= 15
          && d.stage is int && d.stage >= 1 && d.stage <= 10
          && d.level is int && d.level >= 1 && d.level <= 10000
          && d.power is number && d.power >= 0
          && d.power <= math.pow(10, d.realm + 9)
          && d.updatedAt == request.time;
      }
    }
  }
}
