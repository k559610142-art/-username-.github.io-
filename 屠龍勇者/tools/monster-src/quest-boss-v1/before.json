:10,"goldMul":5,"tags":["human"]}},"intro":"「當年打開王城大門的叛將格倫，正躲在腐朽礦坑深處招兵買馬。親手討回公道吧。」","outro":"格倫倒下前喃喃說出：「龍……答應給我們永生……」叛亂的背後，果然有巨龍的影子。","reward":{"item":"royalSword","gold":10000}},{"lv":45,"title":"諸侯的誓約","goal":{"type":"collect","zone":"ivory","itemName":"諸侯誓約書","n":8,"p":0.2,"item":"q_royal_2"},"intro":"「暮光法師塔的魔法師們扣押了各地諸侯的誓約書。取回它們，諸侯就會重新向王族效忠。」","outro":"八位諸侯在誓約書上重新落印。亞丁的旗幟，再次在各地城堡升起。","reward":{"item":"royalAmulet","gold":30000}},{"lv":60,"title":"王座之戰","goal":{"type":"boss","zone":"tower","after":30,"boss":{"name":"篡位者・黑暗之王","icon":"👑","boss":true,"large":true,"lv":62,"hpMul":7,"dmgMul":1.15,"acAdd":-6,"expMul":12,"goldMul":6,"tags":["human"],"magic":{"p":0.25,"dmg":[90,150],"name":"毀滅魔法"}}},"intro":"「篡位者據守永夜之塔，他手中握著與格爾莫斯締結的契約。擊敗他，王國才能團結起來對抗巨龍。」","outro":"篡位者的契約化為灰燼。你登上王座，向全亞丁宣告：「下一個，就是巨龍。」","reward":{"item":"royalKingSword","gold":80000,"elixir":1}},{"lv":60,"title":"超越之證","advCh":5,"goal":{"type":"bossCollect","itemName":"王族之證","n":5,"p":0.2,"item":"q_royal_4"},"intro":"「你已經走到了王族之路的頂點，但頂點之上還有更高的境界。去打倒各地的強大首領，取回 5 枚「王族之證」。」","outro":"宰相阿爾文接過五枚證物，它們同時亮了起來：「它們認同你了。接下來，選擇你要走的道路。」","reward":{"gold":50000}},{"lv":60,"title":"試煉之影","advCh":6,"advPick":true,"goal":{"type":"boss","zone":"fireCave","after":30,"boss":{"name":"王族的試煉之影","icon":"👤","boss":true,"large":true,"lv":63,"hpMul":8,"dmgMul":1.25,"acAdd":-8,"expMul":12,"goldMul":6,"magic":{"p":0.25,"dmg":[80,130],"name":"影之一擊"}}},"intro":"「選擇你要走的道路，然後到熔火煉獄戰勝自己的影子。試煉只能一個人面對：不能帶傭兵，也不能帶娃娃。」","outro":"影子在你面前碎裂，化成光流進你的身體。宰相阿爾文點頭：「從今天起，你就是新的自己。」","reward":{"gold":100000,"advDone":true}},{"lv":70,"title":"進階的考驗","advCh":7,"goal":{"type":"boss","zone":"tower","after":40,"boss":{"name":"逆王之影・格爾德","icon":"👑","boss":true,"large":true,"lv":75,"hpMul":9,"dmgMul":1.3,"acAdd":-10,"expMul":15,"goldMul":8,"magic":{"p":0.28,"dmg":[120,190],"name":"滅世魔法"}}},"intro":"「新的力量引來了新的敵人。逆王之影・格爾德在永夜之塔高層等著你，打倒它，你的力量才算完整。」","outro":"逆王之影・格爾德倒下了。宰相阿爾文交給你一本古老的書與一枚證印：「這是屬於你的道路的全部。」","reward":{"gold":200000,"advFinal":true}}],"knight":[{"lv":15,"title":"見習騎士的試煉","goal":{"type":"collect","zone":"islandDungeon","itemName":"骷髏的頭骨","n":10,"p":0.3,"item":"q_knight_0"},"intro":"「想加入紅騎士團，先證明你的勇氣。到低語墓窟帶回十個骷髏頭骨。」","outro":"「不錯的眼神，和你父親一模一樣。從今天起，你就是紅騎士團的見習騎士。」","reward":{"item":"knightCloak","gold":3000}},{"lv":30,"title":"叛變的騎士","goal":{"type":"boss","zone":"gludio2","after":20,"boss":{"name":"叛變騎士・維克","icon":"🛡️","boss":true,"large":true,"lv":34,"hpMul":8,"dmgMul":1.4,"acAdd":-8,"expMul":10,"goldMul":5,"tags":["human"]}},"intro":"「騎士團出了叛徒。維克帶走團裡的聖劍逃進腐朽礦坑，把他帶回來——活的死的都行。」","outro":"你從維克身上取回了紅騎士之劍。甘特把劍交到你手上：「它現在屬於你了。」","reward":{"item":"knightSword","gold":10000}},{"lv":45,"title":"父親的遺志","goal":{"type":"collect","zone":"pyramid","itemName":"父親的戰記殘頁","n":8,"p":0.2,"item":"q_knight_2"},"intro":"「你父親戰死前把戰記藏在黃沙王陵，裡面記載了格爾莫斯的弱點。把殘頁找回來。」","outro":"戰記最後一頁寫著：「地龍的鱗甲在心臟附近最薄。我的孩子，替我完成這件事。」","reward":{"item":"knightRing","gold":30000}},{"lv":60,"title":"騎士的誓約","goal":{"type":"boss","zone":"tower","after":30,"boss":{"name":"死亡騎士","icon":"💀","boss":true,"large":true,"lv":62,"hpMul":7,"dmgMul":1.15,"acAdd":-6,"expMul":12,"goldMul":6,"undead":true,"tags":["demon"]}},"intro":"「墮落的死亡騎士在永夜之塔徘徊，他曾是最強的紅騎士。擊敗他，你將繼承團長之位。」","outro":"死亡騎士消散前露出微笑：「終於……有人能接下這份重擔了。」甘特將團長披風披在你肩上。","reward":{"item":"knightOathSword","gold":80000,"elixir":1}},{"lv":60,"title":"超越之證","advCh":5,"goal":{"type":"bossCollect","itemName":"騎士之證","n":5,"p":0.2,"item":"q_knight_4"},"intro":"「你已經走到了騎士之路的頂點，但頂點之上還有更高的境界。去打倒各地的強大首領，取回 5 枚「騎士之證」。」","outro":"紅騎士團長甘特接過五枚證物，它們同時亮了起來：「它們認同你了。接下來，選擇你要走的道路。」","reward":{"gold":50000}},{"lv":60,"title":"試煉之影","advCh":6,"advPick":true,"goal":{"type":"boss","zone":"fireCave","after":30,"boss":{"name":"騎士的試煉之影","icon":"👤","boss":true,"large":true,"lv":63,"hpMul":8,"dmgMul":1.25,"acAdd":-8,"expMul":12,"goldMul":6,"magic":{"p":0.25,"dmg":[80,130],"name":"影之一擊"}}},"intro":"「選擇你要走的道路，然後到熔火煉獄戰勝自己的影子。試煉只能一個人面對：不能帶傭兵，也不能帶娃娃。」","outro":"影子在你面前碎裂，化成光流進你的身體。紅騎士團長甘特點頭：「從今天起，你就是新的自己。」","reward":{"gold":100000,"advDone":true}},{"lv":70,"title":"進階的考驗","adv